{
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "target": "ES2020",
    "lib": ["ES2022"],
    "strict": true,
    "declaration": true,
    "composite": true,
    "outDir": "dist",
    "rootDir": "src",
    "useDefineForClassFields": false,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}
